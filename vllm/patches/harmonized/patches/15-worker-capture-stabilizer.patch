+def _xpu_capture_stab(phase: str) -> None:
+    """llm-scaler v29 FIX-2: quiesce the XPU allocator before compile/capture.
+
+    Wedge susceptibility for graphs+spec decode is decided at capture time
+    (piece layout / allocator state; KNOWN_ISSUES #11 v28dbg update). Called
+    at two points in init_device_memory: before the compile/warmup loop and
+    immediately before cudagraph capture. No-op unless XPU and
+    VLLM_XPU_CAPTURE_STAB is unset/on.
+    """
+    if os.environ.get("VLLM_XPU_CAPTURE_STAB", "1") in ("", "0"):
+        return
+    if not torch.xpu.is_available():
+        return
+    torch.xpu.synchronize()
+    torch.xpu.empty_cache()
+    torch.xpu.synchronize()
+    logger.info("llm-scaler v29 capture-stab: %s (allocator reset)", phase)
+
+
