+
+
+# llm-scaler v22 (VLLM_XPU_MTP_EAGER_HEAD): torch.compile of the MTP eagle
+# head crashes TP>1 boot on Intel XPU. During the eagle_head compile warmup
+# the head's sampling path issues oneCCL allgathers from inside
+# dynamo-evaluated code (the full-vocab fp16 logits gather via
+# LogitsProcessor._gather_logits -> compute_logits().argmax(), or the padded
+# [batch, 64] gather in get_top_tokens()), and the CCL ring kernel
+# segfaults: allgatherv_large_su_ring -> "!!!!!!! Segfault encountered !!!!!!"
+# -> VllmWorker died unexpectedly. The exact same collectives run fine when
+# the head is eager (v21 isolation matrix: graphs mode always crashed at
+# k=4 and k=1; eager mode booted at both, E[len] 3.38 at k=4). Keeping the
+# head eager on XPU restores MTP with
+# --compilation-config {"cudagraph_mode":"FULL_DECODE_ONLY"}: the TARGET
+# backbone keeps its XPU decode graphs, only the (single-layer) head runs
+# eager. Both decorated classes must be opted out (Qwen3_5MTP and its inner
+# self.model Qwen3_5MultiTokenPredictor): ignoring only the outer class
+# leaves the inner module compiled. Set VLLM_XPU_MTP_EAGER_HEAD=0 to
+# restore stock behavior.
+def _mtp_eager_head_enabled() -> bool:
+    return current_platform.is_xpu() and (
+        os.environ.get("VLLM_XPU_MTP_EAGER_HEAD", "1") != "0"
+    )
+
+
+if _mtp_eager_head_enabled():
+    ignore_torch_compile(Qwen3_5MultiTokenPredictor)
+    ignore_torch_compile(Qwen3_5MTP)
+    ignore_torch_compile(Qwen3_5MoeMTP)
+    logger.info(
+        "llm-scaler v22: XPU eager MTP head enabled "
+        "(VLLM_XPU_MTP_EAGER_HEAD); MTP head will not be torch.compiled."
+    )
