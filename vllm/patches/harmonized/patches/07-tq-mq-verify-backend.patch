+        if (
+            attn_metadata.num_decodes > 0
+            and attn_metadata.num_decode_tokens < attn_metadata.num_actual_tokens
+        ):
+            attn_metadata.num_decodes = 0
+            attn_metadata.num_decode_tokens = 0
+            attn_metadata.is_prefill = True
+        return attn_metadata
 
 
