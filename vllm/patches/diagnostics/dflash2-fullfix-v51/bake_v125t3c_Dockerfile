# llm-scaler v52 (SPLITS engagement) — bake v1.2.5t3b -> v1.2.5t3c (TEST)
#
# t3c = t3b + v52d EMPTY-ROW telemetry (gpu_model_runner only):
#   get_output() dumps the RAW rejection-sampler row for requests whose
#   parsed emission is empty while NOT discard-masked — the crash-4
#   zombie steady state (v52b n=0; v52c proved mask never set).
#   Taxonomy: all -1 = sampler sentinels (verify skipped, row touched);
#   garbage/huge ints = row NEVER written (outside cu/idx coverage);
#   plausible ids = parse/mask mismatch. Detect-only.
#
# All other overlays identical to t3b (md5-gated).
FROM llm-scaler-exp:v1.2.4

COPY turboquant_attn_v52.py flash_attn_v51.py scheduler_v52.py async_sched_v52.py core_v52.py gpu_model_runner_v52.py /tmp/v125t3c/

RUN set -eux; \
    P=/opt/venv/bin/python; \
    SP=/opt/venv/lib/python3.12/site-packages; \
    TQ=$SP/vllm/v1/attention/backends/turboquant_attn.py; \
    FA=$SP/vllm/v1/attention/backends/flash_attn.py; \
    SCH=$SP/vllm/v1/core/sched/scheduler.py; \
    ASCH=$SP/vllm/v1/core/sched/async_scheduler.py; \
    CORE=$SP/vllm/v1/engine/core.py; \
    GMR=$SP/vllm/v1/worker/gpu_model_runner.py; \
    md5sum "$TQ" | grep -q bde20892409e6eed599d22a627a91b32; \
    md5sum "$FA" | grep -q 50fa85ceeb024067b76163b9718c4730; \
    md5sum "$SCH" | grep -q 73817db55f8712301643146bce895bfb; \
    md5sum "$ASCH" | grep -q 956c51acba291709742e8f40fd5042c1; \
    md5sum "$CORE" | grep -q 1d1ced0db0c33f33d126ebce456caf48; \
    md5sum "$GMR" | grep -q f610bbd3b69902ad923160408cbbcc82; \
    md5sum /tmp/v125t3c/turboquant_attn_v52.py | grep -q eb4c86b1268d109a94cbf7fe483bb297; \
    md5sum /tmp/v125t3c/flash_attn_v51.py | grep -q da085d4e37e20a4c2369c6a3a4035fa8; \
    md5sum /tmp/v125t3c/scheduler_v52.py | grep -q 95f3224bb4d6b887210fac071182f1b7; \
    md5sum /tmp/v125t3c/async_sched_v52.py | grep -q 4ad8eba506a0899144ec0386cae9eb25; \
    md5sum /tmp/v125t3c/core_v52.py | grep -q 82a155d91fc11f289ecaf71093c247fe; \
    md5sum /tmp/v125t3c/gpu_model_runner_v52.py | grep -q 2f9d3ebb8f75e2687e2bd9c829fe5f0b; \
    cp /tmp/v125t3c/turboquant_attn_v52.py "$TQ"; \
    cp /tmp/v125t3c/flash_attn_v51.py "$FA"; \
    cp /tmp/v125t3c/scheduler_v52.py "$SCH"; \
    cp /tmp/v125t3c/async_sched_v52.py "$ASCH"; \
    cp /tmp/v125t3c/core_v52.py "$CORE"; \
    cp /tmp/v125t3c/gpu_model_runner_v52.py "$GMR"; \
    grep -q 'llm-scaler v52 (SPLITS G1)' "$TQ"; \
    grep -q 'VLLM_TQ_MQ_SPLITS' "$TQ"; \
    grep -q '_mq_kv_splits' "$TQ"; \
    grep -q 'VLLM_XPU_FP8_MQ_Q1' "$FA"; \
    grep -q 'llm-scaler v52 (crash-4 fix' "$SCH"; \
    grep -q 'num_new_tokens <= 0' "$SCH"; \
    grep -q 'llm-scaler v52 (crash-4 fix, F8v2' "$ASCH"; \
    grep -q 'VLLM_V52_F8_GRACE' "$ASCH"; \
    grep -q '_v52_parked' "$ASCH"; \
    grep -q 'F8v2: FORCE-FINISH' "$ASCH"; \
    grep -q 'llm-scaler v52 (crash-4 R2 root fix)' "$ASCH"; \
    grep -q '_v52_term_pending' "$ASCH"; \
    grep -q 'flush_pending_finishes' "$ASCH"; \
    grep -q 'llm-scaler v52 (crash-4 R2 root fix)' "$CORE"; \
    grep -q '_v52_flush_pending_finishes' "$CORE"; \
    grep -q 'flush_pending_finishes' "$CORE"; \
    grep -q 'llm-scaler v52c' "$GMR"; \
    grep -q 'v52c DISCARD-GAP' "$GMR"; \
    grep -q '_v52c_seen' "$GMR"; \
    grep -q 'llm-scaler v52d' "$GMR"; \
    grep -q 'v52d EMPTY-ROW' "$GMR"; \
    grep -q '_v52d_seen' "$GMR"; \
    $P -m py_compile "$TQ" "$FA" "$SCH" "$ASCH" "$CORE" "$GMR"; \
    md5sum "$TQ" | grep -q eb4c86b1268d109a94cbf7fe483bb297; \
    md5sum "$FA" | grep -q da085d4e37e20a4c2369c6a3a4035fa8; \
    md5sum "$SCH" | grep -q 95f3224bb4d6b887210fac071182f1b7; \
    md5sum "$ASCH" | grep -q 4ad8eba506a0899144ec0386cae9eb25; \
    md5sum "$CORE" | grep -q 82a155d91fc11f289ecaf71093c247fe; \
    md5sum "$GMR" | grep -q 2f9d3ebb8f75e2687e2bd9c829fe5f0b; \
    rm -rf /tmp/v125t3c; \
    find $SP/vllm -name "__pycache__" -type d -prune -exec rm -rf {} + 2>/dev/null || true; \
    touch /root/.v125t3c_baked; \
    echo "v52 bake OK (v1.2.5t3c = t3b + v52d EMPTY-ROW raw-row telemetry)"
