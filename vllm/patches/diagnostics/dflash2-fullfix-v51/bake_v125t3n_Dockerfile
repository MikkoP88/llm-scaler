# llm-scaler v52 (SPLITS engagement) — bake v1.2.5t3m -> v1.2.5t3n (TEST)
#
# t3n = t3m + crash-4 ESCALATION closure (both worker-death paths):
#   - t3m residual convicted (t3m_engine.log): onset step == fatal step
#     (PRE-COPY computed=4096 sched=8 @23:42:22). Its RAW rejection-
#     sampler row [248320, -1x7] (bonus sentinel == vocab_size from
#     all-NaN target logits) is fed straight to the drafter (GMR
#     use_gpu_toks branch -> propose_draft_token_ids / padded prep)
#     -> embedding gather OOB (IndexKernelUtils.h:63) -> Worker_TP0
#     death +8s -> EngineDeadError. scheduled_spec_decode_tokens
#     [-1x7] is by-design async placeholder transport (worker
#     refills) — NOT schedulable garbage; no scheduler-side spec
#     check is possible.
#   - GMR v52n (escalation-B, immediate death): clone sampled_token_
#     ids; masked_fill_ >= vocab -> 0; feed the CLONE to the drafter
#     only (gpu_toks branch). Original untouched (state/async-copy/
#     parse_output still see the sentinel -> emission still EMPTY).
#     No device sync, no healthy-step cost beyond a B x (k+1) clone.
#   - ASCH v52m (escalation-A, scheduled-zombie lottery): 3
#     consecutive zero/negative parsed emissions while scheduled
#     (v52b counter semantics; structured-output requests exempt)
#     -> immediate FINISHED_ABORTED via R2 terminal stash; plus 5s
#     watchdog for zombies the v52l boundary protocol keeps SKIPping
#     (frozen strike counter — the t3k/t3l wedge shape). No grace:
#     the signature is causal-deterministic (5/5 episodes, zero
#     recoveries), unlike the heuristic F8v2 placeholder trigger.
#     VLLM_V52M_STRIKES=0 disables.
#   - everything else byte-identical to t3m (SCH v52l b878bcd2,
#     CORE v52 82a155d9, TQ/FA/RS/MMU unchanged).
FROM llm-scaler-exp:v1.2.4

COPY turboquant_attn_v52.py flash_attn_v51.py scheduler_v52l.py async_sched_v52m.py core_v52.py gpu_model_runner_v52n.py rejection_sampler_v52e.py mamba_utils_v52f.py /tmp/v125t3n/

RUN set -eux; \
    P=/opt/venv/bin/python; \
    SP=/opt/venv/lib/python3.12/site-packages; \
    TQ=$SP/vllm/v1/attention/backends/turboquant_attn.py; \
