    SCH=$SP/vllm/v1/core/sched/scheduler.py; \
    ASCH=$SP/vllm/v1/core/sched/async_scheduler.py; \
    CORE=$SP/vllm/v1/engine/core.py; \
    GMR=$SP/vllm/v1/worker/gpu_model_runner.py; \
    RS=$SP/vllm/v1/sample/rejection_sampler.py; \
    MMU=$SP/vllm/v1/worker/mamba_utils.py; \
    md5sum "$TQ" | grep -q bde20892409e6eed599d22a627a91b32; \
    md5sum "$FA" | grep -q 50fa85ceeb024067b76163b9718c4730; \
