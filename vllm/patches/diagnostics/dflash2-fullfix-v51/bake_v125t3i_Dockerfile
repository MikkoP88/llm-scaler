#
# t3i = t3f + v52j scheduler worst-case boundary clamp, CORRECTED (1 file
#      changed; v52h worker-side trim stays reverted, GMR = v52f):
#   - async est-optimism model (data-verified twice): actual = est -
#     (prev_scheduled - prev_accepted); t3h PRE-COPY acc_cpu=6 on a prev
#     8-row step -> est 2048 executed at actual 2046; t3g 5/5 -> gap 0.
#   - v52g (t3f) missed the straddle case (est%bs small -> no clamp ->
#     8-row steps executed at 2044/2046 spanning -> 4/4 zombies).
#   - v52i (t3h) room = bs - lo%bs bound at the FARTHEST position (max
#     room) — 7-row step est=2048 lo=2041 executed 2046..2052 spanning.
#   - v52j: if [lo, est] straddles a block boundary -> 1-row degrade
#     (only provably-contained width; plain-decode shape); else clamp to
#     bs - est%bs (binding at actual=est). prev tracked post-clamp.
# All other overlays identical to t3f (md5-gated).
FROM llm-scaler-exp:v1.2.4

COPY turboquant_attn_v52.py flash_attn_v51.py scheduler_v52j.py async_sched_v52.py core_v52.py gpu_model_runner_v52f.py rejection_sampler_v52e.py mamba_utils_v52f.py /tmp/v125t3i/

