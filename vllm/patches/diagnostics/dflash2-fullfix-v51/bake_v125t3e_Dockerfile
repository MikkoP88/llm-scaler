# llm-scaler v52 (SPLITS engagement) — bake v1.2.5t3d -> v1.2.5t3e (TEST)
#
# t3e = t3d + v52f R1 ONSET probes (2 files changed):
#   - gpu_model_runner: (a) INPUT-OOB check on the optimistic input gather
#     (vocab_size pad read => embedding OOB => NaN hiddens); (b) rolling
#     per-request accepted history (last 6 steps); (c) _v52f_ctx stash on
#     AsyncGPUModelRunnerOutput (counters + mamba_state_idx snapshot);
#     (d) v52f CTX dump at the v52d EMPTY-ROW event (nct/ntns/midx/
#     acc_hist/tokwin/istok). v52e ATTR telemetry unchanged.
#   - mamba_utils (NEW overlay): log every mamba align-mode state-copy
#     event (PRE-COPY boundary carry / POST-COPY / DEF-PP async deferred)
#     with bias + arithmetic inputs — bias beyond the accepted count that
#     last wrote the running state reads an unwritten GDN state slot
#     (garbage -> NaN poison; v52e: zombie = all-NaN target logits).
# All other overlays identical to t3d (md5-gated).
FROM llm-scaler-exp:v1.2.4

COPY turboquant_attn_v52.py flash_attn_v51.py scheduler_v52.py async_sched_v52.py core_v52.py gpu_model_runner_v52f.py rejection_sampler_v52e.py mamba_utils_v52f.py /tmp/v125t3e/

