# llm-scaler fp8-mtp4-v3 — v2 (SPLITS=16 + dot knob) + GQA-batched
# stage-1 kernel (knob VLLM_FP8MQ_GQA, default off, live for A/B).
# Grid (B, Hk*NPROG, SPLITS): KV loaded once per 16-row (head,pos)
# block instead of once per q-head (6x -> 2x at k4). Base = v2.
ARG BASE=llm-scaler-exp:fp8-mtp4-v2
FROM ${BASE}
ARG GQA=0
COPY patch_fp8mq_gqa.py /tmp/
RUN /opt/venv/bin/python3 /tmp/patch_fp8mq_gqa.py --gqa-default ${GQA} \
 && /opt/venv/bin/python3 -m py_compile \
      /opt/venv/lib/python3.12/site-packages/vllm/v1/attention/ops/triton_fp8_mq.py \
 && grep -n 'VLLM_FP8MQ_GQA\|_fp8_mq_stage1_gqa\|NPROG' \
      /opt/venv/lib/python3.12/site-packages/vllm/v1/attention/ops/triton_fp8_mq.py \
 && rm /tmp/patch_fp8mq_gqa.py
