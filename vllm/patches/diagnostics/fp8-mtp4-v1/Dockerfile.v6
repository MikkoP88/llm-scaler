# llm-scaler fp8-mtp4-v6 — v5 (flash q=1 fan-out baked ON) + the v34
# e5m2-with-fp8-checkpoint bypass ENV baked, so the validated e5m2 KV
# lane (diag9b dX2: +12-17% @64k, +33-39% @262k over e4m3, slope 0.283
# vs 0.414 µs/KVtok) boots without a per-boot env.
# Safety: single read site (attention.py v34 guard) gated on
# kv_cache_dtype == "fp8_e5m2" — inert for the e4m3/tq4nc lanes.
# Certified by master_diag11: dW6-e4m3 full-knee byte-parity vs dV5-cert
# refs (baked env provably inert) + dW6-e5m2 byte-parity vs dX2-e5m2
# refs (env-passed == env-baked).
# Rollback: docker run -e VLLM_XPU_ALLOW_E5M2_FP8_CKPT=0 overrides the
# ENV; prod_restore_v5.sh returns to the v5 image.
# PRODUCTION TAG: llm-scaler-exp:v1.2.7 (dual-tag, same image ID —
# v1.2.6 number-space is occupied by test tags v1.2.6t1/t2; pattern
# follows v1.2.5 == v1.2.5t5).
FROM llm-scaler-exp:fp8-mtp4-v5
ENV VLLM_XPU_ALLOW_E5M2_FP8_CKPT=1
