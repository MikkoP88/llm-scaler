[Unit]
Description=lsv-test serve log continuous host-side capture (survives container death)
After=docker.service
Wants=docker.service

[Service]
Type=simple
ExecStart=/root/build/serve_live_capture.sh
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
