+        # llm-scaler v31 (#12 clamp): piecewise XPU capture corrupts
+        # temperature-0 output exactly at num_speculative_tokens=4 (k<=3 is
+        # bit-stable == eager reference; KNOWN_ISSUES #12, oneCCL-version-
+        # independent). Clamp k to 3 whenever any capture/compilation mode
+        # remains active (TP=1, or TP>1 through the
+        # VLLM_XPU_ALLOW_UNSAFE_SPEC_TP_GRAPH bypass). Set
+        # VLLM_XPU_ALLOW_K4_CAPTURE=1 to keep k=4 for diagnosis.
+        _spec = vllm_config.speculative_config
+        if (
+            _spec is not None
+            and _spec.num_speculative_tokens is not None
+            and _spec.num_speculative_tokens > 3
+            and compilation_config.cudagraph_mode != CUDAGraphMode.NONE
+            and os.environ.get("VLLM_XPU_ALLOW_K4_CAPTURE", "0")
+            .strip()
+            .lower()
+            not in ("1", "true", "yes", "on")
+        ):
+            logger.warning(
+                "num_speculative_tokens %d -> 3: piecewise XPU capture "
+                "corrupts temperature-0 output exactly at k=4 (KNOWN_ISSUES "
+                "#12). Set VLLM_XPU_ALLOW_K4_CAPTURE=1 to keep k=4 for "
+                "diagnosis.",
+                _spec.num_speculative_tokens,
+            )
+            _spec.num_speculative_tokens = 3
+
